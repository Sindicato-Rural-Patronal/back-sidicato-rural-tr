// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model UserAdmin {
  id           String @id @default(uuid())
  username     String @unique
  passwordHash String

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userData   UserData @relation(fields: [userDataId], references: [id])
  userDataId String   @unique

  rules   Rule   @relation(fields: [rulesId], references: [id])
  rulesId String
}

model UserData {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String   @unique
  avatar    String?
  // CPF único entre cadastros ATIVOS (por dígitos) via índice parcial em
  // migração 20260914120000_userdata_cpf_unique_active — não expressável aqui.
  cpf       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identity
  nickname         String?
  maritalStatus    MaritalStatus?
  phone2           String?
  phone3           String?

  // Documents
  rg               String?
  rgIssuer         String?
  rgIssuedAt       DateTime?
  birthDate        DateTime?
  driverLicense    String?
  driverLicenseCategory String?

  // Origin
  birthPlace       String?
  nationality      String?

  // Profile
  gender           Gender?
  ethnicity        Ethnicity?
  educationLevel   EducationLevel?
  functionalCategory String?
  specialNeeds     Boolean        @default(false)

  // Membership
  memberClassification String?
  // CAD/PRO do associado — até 5 por usuário (validado na aplicação).
  cadPro           String[]
  familyIncome     String?
  memberType       String?
  boardPosition    String?
  boardMember      Boolean        @default(false)
  memberStatus     MemberStatus?
  memberSince      DateTime?
  // Data de validade / fim da associação ("associado até").
  membershipValidUntil DateTime?
  memberNotes      String?
  memberNotesNumber String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  courseUserRegistration courseUserRegistration[]
  userAdmin              UserAdmin?

  userInstructor UserInstructor?
  unimed         UnimedBeneficiario?

  // Relations to other UserData
  relations        UserRelation[] @relation("RelationSource")
  relatedBy        UserRelation[] @relation("RelationTarget")

  // Properties owned
  properties       Property[]
  // Empresas às quais a pessoa está vinculada (com título/cargo)
  companyMemberships CompanyMember[]
  // Aparece em "Nossa Equipe" na página Contato
  publicContact      PublicContact?
  // Propriedade marcada como principal (endereço usado na ficha). Sem FK formal:
  // guarda o id de uma Property do próprio usuário.
  primaryPropertyId String?
}

model UserInstructor {
  id         String   @id @default(uuid())
  bio        String?
  linkedin   String?
  instagram  String?
  facebook   String?
  userData   UserData @relation(fields: [userDataId], references: [id])
  userDataId String   @unique

  courseAssignments CourseInstructor[]
}

model CourseInstructor {
  id           String   @id @default(uuid())
  title        String?
  category     String?
  instructor   UserInstructor @relation(fields: [instructorId], references: [id])
  instructorId String
  course       course   @relation(fields: [courseId], references: [id])
  courseId     String
  isDeleted    Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  @@unique([instructorId, courseId])
}

model Rule {
  id          String @id @default(uuid())
  name        String
  description String

  permissions Permission[]

  userAdmin UserAdmin[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model course {
  id          String   @id @default(uuid())
  name        String
  description String
  startTime   DateTime
  endTime     DateTime

  status               CourseStatus @default(UNPUBLISHED)
  bannerUrl            String?
  price                Float        @default(0)
  workloadHours        Int          @default(0)
  registrationDeadline DateTime?
  observations         String?
  eventNumber          String?
  minStudents          Int          @default(0)
  preEnrolled          Int          @default(0)
  waitlist             Int          @default(0)

  room    room   @relation(fields: [roomId], references: [id])
  roomId  String

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  photos                 CoursePhoto[]
  courseUserRegistration courseUserRegistration[]
  instructors            CourseInstructor[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model CoursePhoto {
  id        String   @id @default(uuid())
  url       String
  caption   String?
  course    course   @relation(fields: [courseId], references: [id])
  courseId  String
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
}

model room {
  id          String   @id @default(uuid())
  name        String
  description String
  maxCapacity Int
  courses     course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addressId  String?
  address    Address? @relation(fields: [addressId], references: [id])
}

enum QuotePeriod {
  MORNING
  AFTERNOON
}

// Cotações exibidas na home. Produtos FIXOS (SOJA, MILHO, TRIGO, MANDIOCA, DOLAR),
// criados na migration; no painel só se lança o preço e o período (manhã/tarde).
// A data de referência é o dia do lançamento. `value` é o texto pronto
// ("R$ 120,00 /sc 60kg"), montado a partir de `priceCents` + `unit`.
model MarketQuote {
  id            String       @id @default(uuid())
  label         String       @unique
  value         String
  priceCents    Int?
  unit          String? // "sc 60kg", "t"… (null = só o preço, ex.: dólar)
  period        QuotePeriod?
  variation     String?
  referenceDate DateTime?
  isActive      Boolean      @default(true)
  order         Int          @default(0)

  history MarketQuoteHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Histórico de valores de uma cotação. A cada novo valor cadastrado guarda-se
// o texto + o número extraído, usado para calcular a variação automaticamente.
model MarketQuoteHistory {
  id            String      @id @default(uuid())
  marketQuote   MarketQuote @relation(fields: [marketQuoteId], references: [id], onDelete: Cascade)
  marketQuoteId String
  value         String
  numeric       Float?
  // Dia + período do lançamento. Relançar o mesmo dia/período substitui a linha.
  referenceDate DateTime?
  period        QuotePeriod?
  createdAt     DateTime    @default(now())

  @@index([marketQuoteId, createdAt])
}

// Trilha de auditoria: registra mutações (POST/PATCH/PUT/DELETE bem-sucedidas)
// feitas via API — quem (actorId), o quê (método/entidade/rota) e quando.
model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  method      String
  path        String
  entity      String
  targetLabel String?
  statusCode  Int
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

// Convite para criar um admin: o gestor escolhe a pessoa (userData) + a regra e
// gera um token. A pessoa abre o link e define username/senha para ativar.
model AdminInvite {
  id         String    @id @default(uuid())
  token      String    @unique
  userDataId String
  rulesId    String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userDataId])
}

model News {
  id          String     @id @default(uuid())
  title       String
  content     String
  summary     String?
  bannerUrl   String?
  status      NewsStatus @default(UNPUBLISHED)
  publishedAt DateTime?
  isDeleted   Boolean    @default(false)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Unicidade (courseId, userDataId) entre inscrições ATIVAS é garantida por
// índice parcial em migração 20260806160000_registration_unique_active —
// parcial não é expressável como @@unique aqui (não adicionar @@unique cheio,
// bloquearia reinscrição após cancelamento).
model courseUserRegistration {
  id         String   @id @default(uuid())
  course     course   @relation(fields: [courseId], references: [id])
  courseId   String
  userData   UserData @relation(fields: [userDataId], references: [id])
  userDataId String

  // Inscrição confirmada pelo admin (pré-requisito p/ iniciar o curso).
  confirmed Boolean @default(false)

  // Ficha de inscrição escaneada e preenchida, anexada pelo admin.
  ficha registrationFicha?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ficha de inscrição escaneada (PDF) anexada a uma inscrição. Guardada no
// banco (privada, servida atrás de auth admin) — sem bucket público.
model registrationFicha {
  id             String                 @id @default(uuid())
  registration   courseUserRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  registrationId String                 @unique
  data           Bytes
  filename       String
  mimeType       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Financeiro: categoria de lançamento (Mensalidade, Salário, Material…).
// Tipada por entrada/saída; cadastrável no painel; soft-delete p/ preservar
// histórico de lançamentos que a referenciam.
model FinancialCategory {
  id        String        @id @default(uuid())
  name      String
  type      FinancialType
  color     String        @default("#64748b")
  active    Boolean       @default(true)
  order     Int           @default(0)
  isDeleted Boolean       @default(false)
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  transactions FinancialTransaction[]
}

// Financeiro: lançamento de caixa. Valor em CENTAVOS (Int) — nunca float.
model FinancialTransaction {
  id          String        @id @default(uuid())
  // null = "só nota" (gera a Nota de Empenho sem lançar no caixa; fora de
  // saldo/KPIs). Editável depois para IN/OUT.
  type        FinancialType?
  amountCents Int
  date        DateTime
  description String
  method      String?
  notes       String?

  category   FinancialCategory? @relation(fields: [categoryId], references: [id])
  categoryId String?

  account   FinancialAccount? @relation(fields: [accountId], references: [id])
  accountId String?

  // Transferência entre caixas: os 2 lançamentos (OUT na origem, IN no destino)
  // compartilham o mesmo transferId. Excluídos dos KPIs de entrada/saída (só movem
  // dinheiro entre caixas, não são receita/despesa).
  transferId String?

  // userAdmin.id de quem lançou (histórico; sem FK formal).
  createdBy String?

  // Dados da Nota de Empenho (fornecedor, NF, banco/cheque, desconto). Opcional;
  // usado para gerar o PDF de quitação do lançamento.
  empenho Json?

  attachments FinancialAttachment[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([date])
  @@index([type])
  @@index([categoryId])
  @@index([accountId])
  @@index([transferId])
}

// Multi-caixa: conta/caixa onde o dinheiro está (Caixa geral, Banco, Poupança…).
// Cada lançamento pode ser atribuído a uma conta; o saldo é apurado por conta.
model FinancialAccount {
  id        String   @id @default(uuid())
  name      String
  color     String   @default("#64748b")
  active    Boolean  @default(true)
  order     Int      @default(0)
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions FinancialTransaction[]
}

// Comprovante/anexo de um lançamento (PDF ou imagem). Guardado no banco
// (privado, servido atrás de auth admin) — mesmo padrão da ficha de inscrição.
model FinancialAttachment {
  id            String               @id @default(uuid())
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  data          Bytes
  filename      String
  mimeType      String
  size          Int
  createdAt     DateTime             @default(now())

  @@index([transactionId])
}

enum FinancialType {
  IN
  OUT
}

enum CourseStatus {
  PUBLIC
  PRIVATE
  UNPUBLISHED
  IN_PROGRESS
}

enum NewsStatus {
  PUBLISHED
  UNPUBLISHED
}

enum Permission {
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  READ_USER

  CREATE_COURSE
  UPDATE_COURSE
  DELETE_COURSE
  READ_COURSE

  CREATE_RULE
  UPDATE_RULE
  DELETE_RULE
  READ_RULE

  CREATE_USER_ADMIN
  UPDATE_USER_ADMIN
  DELETE_USER_ADMIN
  READ_USER_ADMIN

  CREATE_NEWS
  UPDATE_NEWS
  DELETE_NEWS
  READ_NEWS

  READ_CONTACT
  UPDATE_CONTACT

  CREATE_BANNER
  UPDATE_BANNER
  DELETE_BANNER
  READ_BANNER

  CREATE_MARKET_QUOTE
  UPDATE_MARKET_QUOTE
  DELETE_MARKET_QUOTE
  READ_MARKET_QUOTE

  READ_AUDIT

  CREATE_FINANCE
  UPDATE_FINANCE
  DELETE_FINANCE
  READ_FINANCE

  CREATE_CONVENIO
  UPDATE_CONVENIO
  DELETE_CONVENIO
  READ_CONVENIO
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  DOMESTIC_PARTNERSHIP
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Ethnicity {
  WHITE
  BLACK
  MIXED
  ASIAN
  INDIGENOUS
}

enum EducationLevel {
  NO_FORMAL_EDUCATION
  INCOMPLETE_PRIMARY
  COMPLETE_PRIMARY
  INCOMPLETE_SECONDARY
  COMPLETE_SECONDARY
  INCOMPLETE_HIGHER
  COMPLETE_HIGHER
  POSTGRADUATE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum AddressType {
  URBAN
  RURAL
}

model Address {
  id          String      @id @default(uuid())
  type        AddressType @default(URBAN)

  // Shared
  city        String?
  state       String?
  zipCode     String?
  complement  String?
  notes       String?

  // Urban
  street      String?
  number      String?
  neighborhood String?

  // Rural
  localityName String?
  road         String?
  km           String?
  lot          String?
  section      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  properties   Property[]
  rooms        room[]
  companies    Company[]
}

// Propriedade/endereço. Pertence a UMA pessoa OU a UMA empresa — garantido pela
// constraint "Property_single_owner" (CHECK), criada na migration de Company.
model Property {
  id            String    @id @default(uuid())
  userDataId    String?
  companyId     String?
  name          String
  registration  String?
  addressId     String
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userData  UserData? @relation(fields: [userDataId], references: [id], onDelete: Cascade)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  address   Address   @relation(fields: [addressId], references: [id])

  @@index([companyId])
}

model Banner {
  id        String    @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String?
  active    Boolean   @default(true)
  order     Int       @default(0)
  buttons   Json      @default("[]")
  startDate DateTime?
  endDate   DateTime?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ContactMessage {
  id        String    @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  read      Boolean   @default(false)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model UserRelation {
  id        String    @id @default(uuid())
  sourceId  String
  targetId  String
  label     String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  source    UserData @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target    UserData @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)
}

// Configurações gerais do site (key/value): redes sociais, e no futuro
// contato/horários editáveis pelo admin sem novo deploy.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Convênio Unimed: cada beneficiário é um UserData (dados pessoais/endereço lá);
// aqui ficam só os campos específicos do convênio. 1:1 com UserData.
model UnimedBeneficiario {
  id         String   @id @default(uuid())
  userData   UserData @relation(fields: [userDataId], references: [id])
  userDataId String   @unique

  dataAdesao      DateTime?
  tipoMovimento   String? // inclusão titular / inclusão dependente / exclusão...
  tipoDependente  String?
  grauDependencia String?
  cns             String? // Cartão Nacional de Saúde
  nomeMae         String?
  profissao       String?
  plano           String?
  matricula       String?
  empresa         String?
  contratante     String?
  // Titular da família (para dependentes): id de outro UserData; sem FK formal.
  titularId       String?
  motivo          String?
  obs             String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([titularId])
}

// Convênios oferecidos aos associados (Unimed, …). Cada convênio ativo vira uma
// página pública em /convenios/:slug e aparece no menu "Convênios" do site.
// Todo o conteúdo é editável no admin; as listas ficam em JSON:
//   priceRows  → [{ label: "0 a 18 anos", priceCents: 31713 }]
//   documents  → ["RG", "CPF", …]
//   highlights → ["Somos 345 cooperativas", …]
model Convenio {
  id       String  @id @default(uuid())
  slug     String  @unique
  name     String // rótulo no menu: "Unimed"
  title    String // "Tabela de valores / Unimed"
  subtitle String?
  intro    String?
  logoUrl  String?

  priceLabelHeader String @default("Faixa etária")
  priceValueHeader String @default("Valor sindicato")
  priceRows        Json   @default("[]")
  priceNote        String?

  documentsTitle String @default("Documentos para adesão")
  documents      Json   @default("[]")

  highlightsTitle String?
  highlights      Json    @default("[]")

  aboutTitle String?
  aboutText  String?

  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CompanyType {
  PRIVATE
  PUBLIC
}

// Empresa (pessoa jurídica). Separada do cadastro de pessoas (UserData): uma
// empresa se relaciona com várias pessoas, cada uma com um título/cargo, e tem
// suas próprias propriedades/endereços. Parceria pública (logo na home) é da
// empresa. CNPJ único entre empresas ativas via índice parcial na migration.
model Company {
  id                String      @id @default(uuid())
  name              String // razão social
  tradeName         String? // nome fantasia
  cnpj              String? // só dígitos
  stateRegistration String? // inscrição estadual (ou "ISENTO")
  type              CompanyType @default(PRIVATE)
  phone             String? // telefone fixo 1
  phone2            String?
  phone3            String?
  email             String?
  website           String?
  notes             String?

  isPartner    Boolean @default(false)
  partnerUrl   String?
  partnerLogo  String?
  partnerOrder Int?

  // Endereço da empresa (sede). Outros endereços ficam em `properties`.
  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  // Propriedade principal (endereço preferencial). Sem FK formal, como em UserData.
  primaryPropertyId String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  members    CompanyMember[]
  properties Property[]
}

// Vínculo pessoa ↔ empresa com o título da pessoa naquela empresa
// ("SÓCIO", "GERENTE", "CONTADOR"…). Uma pessoa aparece uma vez por empresa.
model CompanyMember {
  id         String   @id @default(uuid())
  companyId  String
  userDataId String
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userData UserData @relation(fields: [userDataId], references: [id], onDelete: Cascade)

  @@unique([companyId, userDataId])
  @@index([userDataId])
}

// Galerias de imagens da home (no lugar dos números "associados/cursos/anos/
// alunos"): ex. História do Sindicato, FAEP, Patrulha Rural. Cada galeria tem
// várias fotos; na home só aparecem as ativas que têm pelo menos uma foto.
model GalleryAlbum {
  id          String   @id @default(uuid())
  title       String
  description String?
  linkUrl     String? // "Saiba mais" opcional (ex.: site da FAEP)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos GalleryPhoto[]
}

model GalleryPhoto {
  id         String       @id @default(uuid())
  albumId    String
  album      GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url        String
  storageKey String
  caption    String?
  order      Int          @default(0)
  createdAt  DateTime     @default(now())

  @@index([albumId, order])
}

// Contatos da página Contato ("Nossa Equipe"). Qualquer pessoa do cadastro,
// com ou sem acesso ao painel; nome, e-mail e telefone vêm do cadastro.
model PublicContact {
  id         String   @id @default(uuid())
  userDataId String   @unique
  userData   UserData @relation(fields: [userDataId], references: [id], onDelete: Cascade)
  title      String? // cargo exibido: Presidente, Secretária…
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
